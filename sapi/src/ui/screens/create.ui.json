{
  "$schema": "https://raw.githubusercontent.com/DogeLakeDev/ScriptsForMinecraftServer/main/modules/sdk/@sfmc-sdk/schemas/ui-screen.v1.schema.json",
  "formatVersion": 1,
  "id": "coop.create",
  "name": "coop.create",
  "presentation": "form",
  "title": "创建合作社",
  "state": {
    "name": {
      "type": "string",
      "default": "",
      "maxLength": 24
    }
  },
  "body": [
    {
      "id": "spacer",
      "type": "spacer",
      "size": "small"
    },
    {
      "id": "name",
      "type": "textField",
      "label": "社名",
      "bind": "state.name",
      "description": "最长 24 个字符，不能包含某些特殊字符。"
    },
    {
      "id": "spacer-2",
      "type": "spacer",
      "size": "small"
    },
    {
      "id": "submit",
      "type": "button",
      "label": "确认创建",
      "tone": "primary",
      "trigger": {
        "type": "action",
        "action": "create"
      }
    },
    {
      "id": "divider",
      "type": "divider"
    },
    {
      "id": "back",
      "type": "button",
      "label": "返回",
      "trigger": {
        "type": "back"
      }
    }
  ],
  "actions": {
    "create": {
      "call": {
        "service": "coop.ui.create",
        "input": {
          "playerId": "{{player.id}}",
          "name": "{{state.name}}"
        }
      },
      "onSuccess": [
        {
          "effect": "message",
          "text": "已创建合作社 {{result.name}}",
          "tone": "success"
        },
        {
          "effect": "replace",
          "to": "coop.home"
        }
      ],
      "onError": [
        {
          "effect": "message",
          "text": "创建失败：{{result.message}}",
          "tone": "danger"
        }
      ]
    }
  }
}
