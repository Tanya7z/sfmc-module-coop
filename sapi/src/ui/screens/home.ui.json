{
  "$schema": "https://cdn.jsdelivr.net/gh/DogeLakeDev/ScriptsForMinecraftServer@latest/modules/sdk/%40sfmc-sdk/schemas/ui-screen.v1.schema.json",
  "formatVersion": 1,
  "id": "coop.home",
  "name": "coop.home",
  "presentation": "reactive",
  "title": "合作社 {{data.overview.coop.name}}",
  "load": {
    "overview": {
      "service": "coop.ui.overview",
      "input": {
        "playerId": "{{player.id}}"
      }
    }
  },
  "body": [
    {
      "id": "not-member",
      "type": "when",
      "condition": {
        "op": "equals",
        "args": [
          {
            "ref": "data.overview.membership"
          },
          {
            "value": null
          }
        ]
      },
      "content": [
        {
          "id": "spacer-3",
          "type": "spacer",
          "size": "small"
        },
        {
          "id": "not-member-tip",
          "type": "info",
          "items": [
            "你尚未加入任何合作社。"
          ],
          "tone": "muted"
        },
        {
          "id": "spacer-2",
          "type": "spacer",
          "size": "small"
        },
        {
          "id": "create",
          "type": "button",
          "label": "创建合作社",
          "trigger": {
            "type": "navigate",
            "to": "coop.create"
          }
        },
        {
          "id": "join",
          "type": "button",
          "label": "加入合作社",
          "trigger": {
            "type": "navigate",
            "to": "coop.join"
          }
        }
      ]
    },
    {
      "id": "spacer",
      "type": "spacer",
      "size": "small"
    },
    {
      "id": "member",
      "type": "when",
      "condition": {
        "op": "notEquals",
        "args": [
          {
            "ref": "data.overview.membership"
          },
          {
            "value": null
          }
        ]
      },
      "content": [
        {
          "id": "overview",
          "type": "info",
          "items": [
            "你的职务：{{data.overview.membership.roleLabel}}",
            "成员数：{{data.overview.coop.memberCount}}"
          ]
        },
        {
          "id": "owner-tip",
          "type": "info",
          "tone": "muted",
          "visibleWhen": {
            "ref": "data.overview.canManageRoles"
          },
          "items": [
            "任命管理员、转让社长请进入「成员管理」。管理员可提现并踢出普通成员。"
          ]
        },
        {
          "id": "spacer-5",
          "type": "spacer",
          "size": "small"
        },
        {
          "id": "dissolve",
          "type": "button",
          "label": "解散合作社",
          "tone": "danger",
          "visibleWhen": {
            "op": "or",
            "args": [
              {
                "ref": "data.overview.canDissolve"
              },
              {
                "op": "equals",
                "args": [
                  {
                    "ref": "data.overview.membership.role"
                  },
                  {
                    "value": "owner"
                  }
                ]
              }
            ]
          },
          "trigger": {
            "type": "action",
            "action": "dissolve"
          }
        },
        {
          "id": "bank",
          "type": "button",
          "label": "小金库",
          "trigger": {
            "type": "navigate",
            "to": "coop.bank"
          }
        },
        {
          "id": "members",
          "type": "button",
          "label": "成员管理",
          "trigger": {
            "type": "navigate",
            "to": "coop.members"
          }
        },
        {
          "id": "rank",
          "type": "button",
          "label": "活跃排行",
          "trigger": {
            "type": "navigate",
            "to": "coop.rank"
          }
        },
        {
          "id": "divider-2",
          "type": "divider"
        },
        {
          "id": "leave",
          "type": "button",
          "label": "退出合作社",
          "visibleWhen": {
            "op": "and",
            "args": [
              {
                "op": "notEquals",
                "args": [
                  {
                    "ref": "data.overview.membership.role"
                  },
                  {
                    "value": "owner"
                  }
                ]
              },
              {
                "op": "not",
                "args": [
                  {
                    "ref": "data.overview.canDissolve"
                  }
                ]
              }
            ]
          },
          "trigger": {
            "type": "action",
            "action": "leave"
          },
          "tone": "danger"
        }
      ]
    },
    {
      "id": "divider",
      "type": "divider"
    },
    {
      "id": "refresh",
      "type": "button",
      "label": "刷新",
      "trigger": {
        "type": "refresh"
      }
    },
    {
      "id": "close",
      "type": "button",
      "label": "关闭",
      "trigger": {
        "type": "close"
      }
    }
  ],
  "actions": {
    "leave": {
      "confirm": {
        "title": "退出合作社",
        "body": "确认退出当前合作社吗？",
        "danger": true,
        "challenge": "我确认退出合作社"
      },
      "call": {
        "service": "coop.ui.leave",
        "input": {
          "playerId": "{{player.id}}"
        }
      },
      "onSuccess": [
        {
          "effect": "message",
          "text": "已退出合作社",
          "tone": "success"
        },
        {
          "effect": "refresh"
        }
      ]
    },
    "dissolve": {
      "confirm": {
        "title": "解散合作社",
        "body": "确认解散 {{data.overview.coop.name}}？成员将全部移除，公账余额不会自动清零。",
        "confirmText": "确认解散",
        "danger": true,
        "challenge": "我确认解散该合作社"
      },
      "call": {
        "service": "coop.ui.dissolve",
        "input": {
          "playerId": "{{player.id}}"
        }
      },
      "onSuccess": [
        {
          "effect": "message",
          "text": "合作社已解散",
          "tone": "success"
        },
        {
          "effect": "refresh"
        }
      ]
    }
  }
}
