    "provides": [
      {
        "name": "coop.byId",
        "input": {
          "type": "object"
        },
        "output": {
          "type": "object"
        }
      },
      {
        "name": "coop.list",
        "input": {
          "type": "object"
        },
        "output": {
          "type": "object"
        }
      },
      {
        "name": "coop.byPlayer",
        "input": {
          "type": "object"
        },
        "output": {
          "type": "object"
        }
      },
      {
        "name": "coop.ui.overview",
        "input": { "type": "object" },
        "output": { "type": "object" }
      },
      {
        "name": "coop.ui.members",
        "input": { "type": "object" },
        "output": { "type": "object" }
      },
      {
        "name": "coop.ui.rank",
        "input": { "type": "object" },
        "output": { "type": "object" }
      },
      {
        "name": "coop.ui.create",
        "input": { "type": "object" },
        "output": { "type": "object" }
      },
      {
        "name": "coop.ui.join",
        "input": { "type": "object" },
        "output": { "type": "object" }
      },
      {
        "name": "coop.ui.leave",
        "input": { "type": "object" },
        "output": { "type": "object" }
      },
      {
        "name": "coop.ui.deposit",
        "input": { "type": "object" },
        "output": { "type": "object" }
      },
      {
        "name": "coop.ui.withdraw",
        "input": { "type": "object" },
        "output": { "type": "object" }
      },
      {
        "name": "coop.ui.transfer",
        "input": { "type": "object" },
        "output": { "type": "object" }
      },
      {
        "name": "coop.ui.kick",
        "input": { "type": "object" },
        "output": { "type": "object" }
      },
      {
        "name": "coop.ui.dissolve",
        "input": { "type": "object" },
        "output": { "type": "object" }
      }
