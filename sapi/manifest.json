    "db:write:sfmc_coop_members",
    "service:coop.byId",
    "service:coop.list",
    "service:coop.byPlayer",
    "service:coop.ui.overview",
    "service:coop.ui.members",
    "service:coop.ui.rank",
    "service:coop.ui.create",
    "service:coop.ui.join",
    "service:coop.ui.leave",
    "service:coop.ui.deposit",
    "service:coop.ui.withdraw",
    "service:coop.ui.transfer",
    "service:coop.ui.kick",
    "service:coop.ui.dissolve",
    "service:economy.account.get",
    "service:economy.account.transfer",
    "service:activity.record"
