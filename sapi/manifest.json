      {
        "name": "economy.account.get"
      },
      {
        "name": "economy.account.transfer"
      },
      {
        "name": "activity.record"
      }
    ]
  },
  "notes": "公账 coop:<cid> 托管 economy；审计 activity.record(eventType=coop.audit)；全部玩家界面由声明式 JSON 定义。"
}
